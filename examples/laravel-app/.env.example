APP_NAME="Laravel CI Example"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Injected at build time from the Git tag. Empty means "dev".
APP_VERSION=

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
